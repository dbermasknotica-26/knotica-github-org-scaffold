# ---- Edit these ----
# MODE="personal": test everything in your PERSONAL GitHub account (ORG = your GitHub username).
#                  Skips what only exists in organizations: teams, team permissions, org settings,
#                  org Projects wiring and branch protection.
# MODE="org":      full setup in a GitHub ORGANIZATION (ORG = the organization slug).
# You can override on the command line:  MODE=org ./setup/setup.sh
MODE="${MODE:-personal}"
ORG="dbermasknotica-26"            # personal mode: your GitHub username | org mode: org slug (e.g. knotica-solutions)
GIT_USER_NAME="dbermasknotica-26"
# REQUIRED: the email for commit authorship. Use your own address, or your GitHub no-reply address
# (GitHub > Settings > Emails shows it as <id>+<username>@users.noreply.github.com).
GIT_USER_EMAIL="CHANGE-ME@example.com"
# Safety: stays "true" (prints commands only) unless you export DRY_RUN=false
DRY_RUN="${DRY_RUN:-true}"
